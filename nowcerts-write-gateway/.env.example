PORT=8787
HOST=127.0.0.1
GATEWAY_MODE=shadow
GATEWAY_DATA_DIR=./data
OPENAI_MODEL=gpt-5.6
# MCP_ALLOWED_ORIGIN=https://trusted-local-test-origin.example

# Encryption at rest for intake bundles and write proposals (AES-256-GCM).
# REQUIRED in any deployment that captures contact DOB or driver's licence —
# that is regulated PII and must not sit on disk as plaintext JSON.
# Generate: openssl rand -hex 32
# Unset => records are written as plaintext (local/offline development only).
# Existing plaintext files stay readable after a key is added; each rewrite
# upgrades them. Losing the key makes already-encrypted records unrecoverable —
# store it in 1Password (rsg_infrastructure) before enabling.
# GATEWAY_ENCRYPTION_KEY_FILE=/etc/rsg-intake-gate/record-encryption-key
# GATEWAY_ENCRYPTION_KEY=            # inline alternative; prefer the file

# Malware scanning for uploads (clamd). REQUIRED once image uploads are enabled:
# an image decoder is a far larger attack surface than pdftotext. A configured
# scanner that cannot be reached REJECTS uploads — it never admits them
# unscanned. REQUIRE_MALWARE_SCAN=on additionally refuses uploads when no
# scanner is configured at all; set it in every deployment.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=30000
# REQUIRE_MALWARE_SCAN=on

# OCR for scanned documents (local Tesseract binary — nothing is sent off-host).
# Driver's licences do NOT use OCR: their PDF417 barcode decodes to exact AAMVA
# fields via the bundled WASM decoder, which needs no configuration.
# TESSERACT_BIN=tesseract
# TESSERACT_LANG=eng

# NAICS_API_* is gone with the NaicsEnricher that read it. Class codes on an
# intake come from reference-classifier.js against our own reference tables, not
# from a third-party suggestion service.

# Live writes are not implemented in the shadow-mode build.
# Add NowCerts secrets only through the production secret manager.
# Never commit credentials to this file or the repository.

# ATTOM property data API (populates the risk report's property_profile:
# year_built / square_feet / construction / roof / stories). Auth = APIKey header.
# ATTOM does NOT return protection_class / flood_zone / replacement_cost here.
# ATTOM_API_URL=https://api.gateway.attomdata.com/propertyapi/v1.0.0
# ATTOM_API_KEY=...            # or ATTOM_API_KEY_FILE=/etc/rsg-intake-gate/attom-api-key
# County-level ISO fire protection class (approximation; labeled "county estimate").
# Point at a STRUCTURED table, never a hand-read map. JSON:
#   {"year":2018,"table":{"GA":{"fulton":3,"cobb":2,...}}}
# PROTECTION_CLASS_TABLE_FILE=/etc/rsg-intake-gate/ga-county-iso.json
# Interim replacement-cost estimate ($/sqft) until a real RCE (Verisk 360Value) is wired.
# RCE_STUB_PER_SQFT=250

# Hermes CRM opportunity writes (POST /api/opportunities). Ships DARK.
# Set to 1 only after verifying against one real intake. Opportunities are
# additive: a Hermes outage is reported in the intake's `crm` block and never
# blocks the insured proposal or the retained report.
# Uses HERMES_PREVIEW_URL above -- no separate base URL, no bearer token (the
# API is unauthenticated on the internal network).
# HERMES_CRM_WRITES=1

# Optional bearer for the token-gated Hermes routes (/api/hermes/book-sync,
# /api/ams/search-insured, /api/hermes/tts). Most routes -- including
# /agency-intake, /dispatch, and /api/opportunities -- are unauthenticated on
# the internal network, so this is not required today.
#
# A configured-but-EMPTY value is refused at startup. That is deliberate: the
# rsg-hermes bridge outage on 2026-07-26 was an empty token being treated as
# "no auth", which silently omitted the header and 401'd every protected route
# while the config looked correct.
# HERMES_API_TOKEN_FILE=/etc/rsg-intake-gate/hermes-api-token
# HERMES_API_TOKEN=
